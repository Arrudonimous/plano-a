# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (nunca no navegador): cron, webhook, cotações, rate limit, conteúdo premium, excluir conta.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron (Vercel envia "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=

# --- Cápsula do Tempo (e-mail via Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Plano A <capsula@seu-dominio.com>

# --- Afirmações diárias (Claude) ---
ANTHROPIC_API_KEY=
# Opcional. Padrão claude-opus-5-5; também aceita claude-opus-5, claude-sonnet-5-5 (mais barato) e claude-fable-5-1
AFFIRMATIONS_MODEL=

# --- Pagamentos (Stripe). Sem estas variáveis a página /planos mostra "em breve" ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs dos preços recorrentes criados no painel da Stripe (o valor exibido vem da própria Stripe)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Analytics com consentimento (sem esta variável nada é registrado) ---
# Um segredo longo e aleatório; é o "sal" do pseudônimo dos usuários.
ANALYTICS_SALT=

# --- Páginas legais (Privacidade e Termos) ---
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Opcional: aviso de erros do servidor (URL de webhook do Slack/Discord) ---
ERROR_WEBHOOK_URL=
